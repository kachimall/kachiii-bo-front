NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8002/api/v1
# Courier-update buttons that play Zajel while the backend runs its mock courier. Default: on in
# development, off in production builds; set true for a test server, false to hide them.
# NEXT_PUBLIC_MOCK_COURIER=true
# Cloudflare Turnstile's site key, when the API has TURNSTILE_SECRET_KEY set (login then needs the
# widget's token). Leave unset while the API's bot check is off.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
